# kimo settings (all optional). Flags override these.
# Where to listen: localhost | lan | tailscale | zerotier | <ip>
KIMO_BIND=localhost
KIMO_PORT=7777
# Access token required when not on localhost. Generated and printed at start when empty.
KIMO_TOKEN=
# Extra origins (comma separated) where the owner token may be used from other pages.
# Apps normally get their own key instead (Apps tab).
KIMO_ORIGINS=
# Data folder (state.json and account config homes). Default: ~/.kimo
KIMO_DATA_DIR=
# Bytes of terminal output kept per session for reconnecting clients.
KIMO_SCROLLBACK=262144
# Log level, e.g. kimo=debug
RUST_LOG=kimo=info
