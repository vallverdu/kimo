# kimo settings (all optional). Flags override these.
# Where to listen: all | localhost | tailscale | zerotier | <ip>
KIMO_BIND=all
KIMO_PORT=7777
# Optional owner token for scripts. Devices normally pair with a QR code (Devices tab, `kimo pair`).
KIMO_TOKEN=
# Requests from this machine itself are the owner. Set false on machines shared with other users.
KIMO_LOCAL_OWNER=true
# This machine's name for paired kimos (prefix of its agents' ids there). Default: hostname
KIMO_NAME=
# Where new projects are created. Default: ~/dev
KIMO_PROJECTS_DIR=
# Extra origins (comma separated) where the owner token may be used from other pages.
# Apps normally get their own key instead (Apps tab).
KIMO_ORIGINS=
# Data folder (state.json and account config homes). Default: ~/.kimo
KIMO_DATA_DIR=
# Bytes of terminal output kept per session for reconnecting clients.
KIMO_SCROLLBACK=262144
# The fleet coordinator on this machine (kimo-fleet): the owner's apps reach it at /api/fleet
# and the phone shows the Fleet tab. Default: none
KIMO_FLEET=
# Key for the coordinator, when it asks for one.
KIMO_FLEET_TOKEN=
# What POST /api/power/shutdown runs. Default: systemctl poweroff (falling back to
# sudo -n systemctl poweroff) on Linux, System Events on macOS.
KIMO_SHUTDOWN_COMMAND=
# 1: people logged in (a desktop that logs in by itself) do not keep the machine on.
KIMO_SHUTDOWN_IGNORE_LOGINS=
# Log level, e.g. kimo=debug
RUST_LOG=kimo=info
